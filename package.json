{
  "name": "honeypot",
  "module": "src/bot.ts",
  "type": "module",
  "private": true,
  "main": "src/bot.ts",
  "scripts": {
    "start": "bun src/bot.ts",
    "dev": "bun --watch src/bot.ts",
    "build:standalone": "bun build src/bot.ts --outfile dist/bot --minify --target=bun --bytecode --production --compile --format=esm --sourcemap --trim --define=process.env.HAS_PROXY_WS:undefined",
    "docker:build": "docker compose build",
    "docker:deploy": "docker stack ls --format '{{.Name}}' | grep -q '^honeypot$' && { echo 'Error: Stack exists'; false; } || { docker compose pull && docker compose up -d; }",
    "docker:logs": "docker compose logs -f",
    "-": "echo --spacer--",
    "build:events:standalone": "bun build src/sharded/event-handler.ts --outfile dist/event-handler --minify --target=bun --bytecode --production --compile --format=esm --sourcemap --trim --define=process.env.HAS_PROXY_WS:true",
    "build:ws:standalone": "bun build src/sharded/discord-ws.ts --outfile dist/discord-ws --minify --target=bun --bytecode --production --compile --format=esm --sourcemap --trim",
    "build:stats:standalone": "bun build src/sharded/stats-api.ts --outfile dist/stats-api --minify --target=bun --bytecode --production --compile --format=esm --sourcemap --trim --aot",
    "build:*:standalone": "bun run build:standalone && bun run build:events:standalone && bun run build:ws:standalone && bun run build:stats:standalone",
    "docker:swarm:deploy": "(docker swarm init || true) && bun --env-file=.env run docker stack deploy -c docker-compose.sharded.yml honeypot --detach=false",
    "docker:swarm:build": "docker build -f Dockerfile.events -t ghcr.io/riskymh/honeypot-events:latest . && docker build -f Dockerfile.ws -t ghcr.io/riskymh/honeypot-ws:latest . && docker build -f Dockerfile.stats -t ghcr.io/riskymh/honeypot-stats:latest .",
    "docker:logs:events": "docker service logs -tf honeypot_discord-events",
    "docker:logs:ws": "docker service logs -tf honeypot_discord-ws"
  },
  "devDependencies": {
    "@types/bun": "npm:bun-types@^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@discordjs/core": "3.0.0-dev.1793836959-ddbba3adb",
    "@discordjs/rest": "3.0.0-dev.1793836959-ddbba3adb",
    "@discordjs/ws": "3.0.0-dev.1793836959-ddbba3adb",
    "discord-api-types": "^0.38.57"
  },
  "overrides": {
    "@vladfrangu/async_event_emitter": "https://github.com/vladfrangu/async_event_emitter#877001a",
    "discord-api-types": "https://github.com/discordjs/discord-api-types#00cbe03"
  },
  "patchedDependencies": {
    "@vladfrangu/async_event_emitter@github:vladfrangu/async_event_emitter#877001a": "patches/@vladfrangu+async_event_emitter.patch",
    "discord-api-types@github:discordjs/discord-api-types#00cbe03": "patches/discord-api-types.patch"
  },
  "trustedDependencies": []
}